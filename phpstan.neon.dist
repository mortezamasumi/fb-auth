includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # toEN() is registered on TextInput at runtime by fb-essentials'
        # FormMacroServiceProvider (TextInput::macro('toEN', ...)), so PHPStan
        # cannot resolve it statically.
        - message: '#toEN\(\)#'
          path: src
